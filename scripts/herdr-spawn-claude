#!/usr/bin/env bash
# Start a Claude pane for one repository in that repository's herdr workspace.
#
# Usage: herdr-spawn-claude <repo> [--focus] [--name NAME] [-- <claude args...>]
#   <repo>  directory name under ~/workspace, or an absolute path
#
# One workspace per repository, labelled with the repository directory name.
# The workspace is created when it does not exist yet.
set -euo pipefail

WORKSPACE_ROOT="${WORKSPACE_ROOT:-$HOME/workspace}"

die() { printf 'herdr-spawn-claude: %s\n' "$1" >&2; exit 1; }

[ "${HERDR_ENV:-}" = 1 ] || die 'not running inside a herdr pane (HERDR_ENV is unset)'
[ $# -ge 1 ] || die 'usage: herdr-spawn-claude <repo> [--focus] [--name NAME] [-- <claude args...>]'

repo_arg=$1; shift
focus=--no-focus
agent_name=
claude_args=()
while [ $# -gt 0 ]; do
  case $1 in
    --focus)    focus=--focus; shift ;;
    --no-focus) focus=--no-focus; shift ;;
    --name)     agent_name=${2:?--name needs a value}; shift 2 ;;
    --)         shift; claude_args=("$@"); break ;;
    *)          die "unknown option: $1" ;;
  esac
done

case $repo_arg in
  /*) repo_path=$repo_arg ;;
  *)  repo_path=$WORKSPACE_ROOT/$repo_arg ;;
esac
[ -d "$repo_path" ] || die "no such directory: $repo_path"
repo_path=$(cd "$repo_path" && pwd)
repo_name=$(basename "$repo_path")

# Reuse the workspace already labelled for this repository, else create it.
workspace_id=$(herdr workspace list |
  jq -r --arg label "$repo_name" \
    'first(.result.workspaces[] | select(.label == $label) | .workspace_id) // empty')

if [ -z "$workspace_id" ]; then
  workspace_id=$(herdr workspace create --cwd "$repo_path" --label "$repo_name" --no-focus |
    jq -r '.result.workspace.workspace_id')
  [ -n "$workspace_id" ] || die "could not create a workspace for $repo_name"
  printf 'created workspace %s (%s)\n' "$workspace_id" "$repo_name" >&2
fi

# Agent names must be unique across the session; suffix until one is free.
if [ -z "$agent_name" ]; then
  taken=$(herdr agent list | jq -r '.result.agents[].name // empty')
  agent_name=$repo_name
  n=2
  while printf '%s\n' "$taken" | grep -qx "$agent_name"; do
    agent_name=$repo_name-$n
    n=$((n + 1))
  done
fi

herdr agent start "$agent_name" \
  --cwd "$repo_path" \
  --workspace "$workspace_id" \
  --split down \
  "$focus" \
  -- claude "${claude_args[@]+"${claude_args[@]}"}" |
  jq -r '.result.agent | "started \(.name) in \(.pane_id) (cwd \(.cwd))"'
