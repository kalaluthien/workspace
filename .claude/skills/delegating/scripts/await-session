#!/usr/bin/env bash
# Block until a delegated session reaches a status or prints a sentinel, then
# show its recent output. One long wait per session beats polling; for
# multi-session monitoring, run once per session from a /loop tick instead of
# blocking on all of them.
#
# Usage: await-session <target> [--status idle|blocked|done] [--match TEXT]
#                      [--timeout MS] [--lines N]
# Default: --status idle --timeout 600000. Exits non-zero on timeout.
source "$(dirname "$0")/_lib.sh"
require_herdr

target=${1:?usage: await-session <target> [--status S | --match TEXT]}; shift
status=idle match= timeout=600000 lines=40
while [ $# -gt 0 ]; do
  case $1 in
    --status)  status=${2:?}; shift 2 ;;
    --match)   match=${2:?}; shift 2 ;;
    --timeout) timeout=${2:?}; shift 2 ;;
    --lines)   lines=${2:?}; shift 2 ;;
    *)         die "unknown option: $1" ;;
  esac
done

pane=$(pane_of "$target")
# herdr 0.8.0 renamed the wait commands: `wait output` -> `pane wait-output`,
# `wait agent-status` -> `agent wait --until`.
if [ -n "$match" ]; then
  herdr pane wait-output "$pane" --match "$match" \
    --source recent-unwrapped --timeout "$timeout" >/dev/null ||
    die "timeout: '$match' not seen in $pane within ${timeout}ms"
else
  herdr agent wait "$pane" --until "$status" --timeout "$timeout" \
    >/dev/null || die "timeout: $pane not $status within ${timeout}ms"
fi
herdr pane read "$pane" --source recent-unwrapped --lines "$lines"
