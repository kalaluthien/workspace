#!/usr/bin/env bash
# Launch a named claude session for one repository, reusing the repository's
# herdr workspace and giving the session a tab of its own — a tab holds one
# session, so a pane is never split. Blocks until the session is idle.
#
# The name says what the session is for — <role>-<task>, for example
# survey-tflite-detectors or build-preview-crash. Every session launches as
# Opus (a session owns decisions; Fable stays with the orchestrator, per
# ~/.claude/CLAUDE.md "Claude Code"). Pass --effort per the task's breadth —
# the default medium fits a narrow scope. --model is an escape hatch for one
# session.
#
# Usage: launch-session <repo> <role>-<task>
#                       [--model fable|opus|sonnet|haiku]
#                       [--effort low|medium|high|xhigh]
#                       [-- <extra claude args...>]
# Output: {"name":..., "role":..., "model":..., "effort":...,
#          "pane":..., "tab":..., "workspace":...}
source "$(dirname "$0")/_lib.sh"
require_herdr

repo_arg=${1:?usage: launch-session <repo> <role>-<task>}
want=${2:?usage: launch-session <repo> <role>-<task>}
shift 2
model= effort= extra=()
while [ $# -gt 0 ]; do
  case $1 in
    --model)  model=${2:?}; shift 2 ;;
    --effort) effort=${2:?}; shift 2 ;;
    --)       shift; extra=("$@"); break ;;
    *)        die "unknown option: $1" ;;
  esac
done

path=$(repo_path "$repo_arg")
[ -d "$path" ] || die "no such directory: $path"
label=$(basename "$path")

name=$(free_name "$want")
role=$(role_of "$name")
[ -n "$model" ] || model=opus
[ -n "$effort" ] || effort=medium

# herdr 0.8.0: `agent start` no longer creates its pane — it claims an
# existing shell pane (--kind --pane) and appends AGENT_ARGs to the kind's
# canonical executable. Creating a workspace or a tab yields that shell as
# `.result.root_pane`, so a session's pane always arrives with its own tab:
# a full-height pane keeps a session readable, and herdr retires the tab with
# the pane when the session is swept.
ws=$(workspace_id_for_label "$label") pane= tab=
if [ -z "$ws" ]; then
  created=$(herdr workspace create --cwd "$path" --label "$label" --no-focus)
  ws=$(printf '%s' "$created" | jq -r '.result.workspace.workspace_id // empty')
  [ -n "$ws" ] || die "could not create a workspace for $label"
else
  created=$(herdr tab create --workspace "$ws" --cwd "$path" --no-focus)
fi
tab=$(printf '%s' "$created" | jq -r '.result.tab.tab_id // empty')
pane=$(printf '%s' "$created" | jq -r '.result.root_pane.pane_id // empty')
[ -n "$pane" ] || die "could not obtain a shell pane in $ws"

# A fresh pane's shell takes a moment to reach its prompt, and agent start
# refuses a pane that is not an available shell (agent_pane_busy) — retry.
attempts=0 started=
until started=$(herdr agent start "$name" --kind claude --pane "$pane" \
    --timeout 90000 \
    -- --model "$model" --effort "$effort" ${extra[@]+"${extra[@]}"} 2>&1); do
  attempts=$((attempts + 1))
  [ "$attempts" -lt 10 ] || die "agent start failed: $started"
  sleep 1
done
pane=$(printf '%s' "$started" | jq -r '.result.agent.pane_id // empty')
[ -n "$pane" ] || die "agent start failed: $started"

herdr agent wait "$pane" --until idle --timeout 90000 >/dev/null ||
  die "session $name ($pane) did not become idle in 90s"

jq -nc --arg n "$name" --arg r "$role" --arg m "$model" --arg e "$effort" \
  --arg p "$pane" --arg t "$tab" --arg w "$ws" \
  '{name: $n, role: $r, model: $m, effort: $e,
    pane: $p, tab: $t, workspace: $w}'
