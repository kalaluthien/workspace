#!/usr/bin/env bash
# Report the delegable sessions for one repository (or all of ~/workspace):
# every agent pane with its name, role, status and verdict. The orchestrator
# reads this to decide reuse (a free verdict, and a role whose model suits the
# new task) versus launch. A session is free to claim when its verdict is
# empty or done; see session_verdict in _lib.sh for why status is not enough.
# Tabs are not reported: launch-session gives every session a tab of its own,
# so no tab has capacity to weigh.
#
# Usage: check-sessions [<repo>]
# Output: one JSON object -> {repo, workspace_id, agents: [...]}
# per repository, one per line.
source "$(dirname "$0")/_lib.sh"
require_herdr

scan() {
  local path=$1 label ws
  label=$(basename "$path")
  ws=$(workspace_id_for_label "$label")
  local agents='[]'
  if [ -n "$ws" ]; then
    agents=$(herdr agent list | jq -c --arg path "$path" '
      [.result.agents[]
       | select(.cwd == $path or (.cwd | startswith($path + "/")))
       | {name, agent, status: .agent_status, pane: .pane_id}]')
    # A name reads <role>-<task>; the role says what the pane was launched for
    # and therefore which model it runs. A null name means an unmanaged session.
    agents=$(printf '%s' "$agents" | jq -c '
      [.[] | . + {role: (if (.name // "") | test("^[a-z]+-.")
                         then (.name | split("-")[0]) else null end)}]')
    # Reuse follows the verdict, not the status: a session that pauses
    # mid-turn reports idle, and claiming it clears work still running.
    local merged='[]' row v
    while IFS= read -r row; do
      [ -n "$row" ] || continue
      v=$(session_verdict \
            "$(printf '%s' "$row" | jq -r '.pane')" \
            "$(printf '%s' "$row" | jq -r '.name // ""')" \
            "$(printf '%s' "$row" | jq -r '.status')")
      merged=$(printf '%s' "$merged" |
        jq -c --argjson a "$row" --arg v "$v" '. + [$a + {verdict: $v}]')
    done <<< "$(printf '%s' "$agents" | jq -c '.[]')"
    agents=$merged
  fi
  jq -nc --arg repo "$label" --arg ws "$ws" --argjson agents "$agents" \
    '{repo: $repo, workspace_id: (if $ws == "" then null else $ws end),
      agents: $agents}'
}

if [ $# -ge 1 ]; then
  scan "$(repo_path "$1")"
else
  for p in "$WORKSPACE_ROOT"/*/; do
    [ -d "$p/.git" ] && scan "${p%/}"
  done
fi
