#!/usr/bin/env bash
# Classify every delegated session in ~/workspace and retire the spent ones.
# A session is spent when it holds no work (empty) or when its last word was
# the completion sentinel (done); everything else is reported, never closed.
#
# Two exclusions are structural, not options. Enumeration walks the repository
# entries, so sessions in the container root are out of reach, and the calling
# pane ($HERDR_PANE_ID) is skipped so a sweep cannot close itself.
#
# Usage: sweep-sessions [<repo>] [--close] [--lines N]
# Output: one JSON object per session, one per line ->
#         {repo, name, pane, verdict, closed}
# Verdicts: empty | done | pending, for a quiet pane, plus the herdr status
#           (working | blocked | unknown) for a pane not worth reading.
#           --close acts on empty and done. A pending session is waiting on an
#           answer or finished without a sentinel, so its fate is a judgement
#           this script does not make.
source "$(dirname "$0")/_lib.sh"
require_herdr

repo_arg= close=false lines=200
while [ $# -gt 0 ]; do
  case $1 in
    --close) close=true; shift ;;
    --lines) lines=${2:?}; shift 2 ;;
    -*)      die "unknown option: $1" ;;
    *)       repo_arg=$1; shift ;;
  esac
done

# verdict <pane> <name> -> empty | done | pending | unknown
#
# The pane text is the only evidence: the agent record carries a status, never
# a turn count. Two markers carry the classification — the assistant bullet
# says the session produced output, and a prompt line carrying anything but a
# slash command says it was given work. Both must be absent for empty, because
# herdr reports a quiet pane as idle and a session thinking through its first
# turn has the prompt and no bullet yet. The sentinel counts only when no later
# prompt line reopened the session, and an unnamed session carries no sentinel
# to match. Splitting on a marker avoids assuming its byte width, and a read
# that comes back with nothing is a failed read, not an empty session.
verdict() {
  herdr pane read "$1" --source recent-unwrapped --lines "$lines" |
    awk -v name="$2" '
      BEGIN { sentinel = (name == "" ? "" : "DONE " name) }
      { seen = NR }
      index($0, "\342\217\272") { output = 1 }                   # the assistant bullet
      sentinel != "" && index($0, sentinel) { done_at = NR }
      {
        if (index($0, "\342\235\257")) {                         # the prompt marker
          n = split($0, part, "\342\235\257")
          rest = part[n]; gsub(/[[:space:]]/, "", rest)
          if (rest != "" && substr(rest, 1, 1) != "/") input_at = NR
        }
      }
      END {
        if (!seen)                                  print "unknown"
        else if (!output && !input_at)              print "empty"
        else if (done_at > 0 && done_at > input_at) print "done"
        else                                        print "pending"
      }'
}

sweep() {
  local path=$1 label rows
  label=$(basename "$path")
  rows=$(herdr agent list | jq -c --arg path "$path" '
    .result.agents[]
    | select(.cwd == $path or (.cwd | startswith($path + "/")))
    | {name: .name, pane: .pane_id, status: .agent_status}')

  local row name pane status v closed
  while IFS= read -r row; do
    [ -n "$row" ] || continue
    name=$(printf '%s' "$row" | jq -r '.name // ""')
    pane=$(printf '%s' "$row" | jq -r '.pane')
    status=$(printf '%s' "$row" | jq -r '.status')
    [ "$pane" = "${HERDR_PANE_ID:-}" ] && continue

    # herdr reports idle|working|blocked|done|unknown. Only a quiet pane is
    # worth reading: working is mid-turn, blocked is holding a permission
    # prompt, and unknown means the detector could not tell — none of them may
    # be closed on the strength of what the screen happens to show.
    case $status in
      idle|done) v=$(verdict "$pane" "$name") ;;
      *)         v=$status ;;
    esac

    closed=false
    if $close && { [ "$v" = empty ] || [ "$v" = done ]; }; then
      herdr pane close "$pane" >/dev/null
      closed=true
    fi
    jq -nc --arg repo "$label" --arg name "$name" --arg pane "$pane" \
      --arg v "$v" --argjson closed "$closed" \
      '{repo: $repo, name: (if $name == "" then null else $name end),
        pane: $pane, verdict: $v, closed: $closed}'
  done <<< "$rows"
}

if [ -n "$repo_arg" ]; then
  sweep "$(repo_path "$repo_arg")"
else
  for p in "$WORKSPACE_ROOT"/*/; do
    if [ -d "$p/.git" ]; then sweep "${p%/}"; fi
  done
fi
