#!/usr/bin/env bash
# Emit one line per worker as it stops needing the orchestrator,
# and exit when every named session has. Written for the Monitor tool, which
# turns each stdout line into a notification and ends the watch on exit, so
# several delegations can be awaited at once without blocking a turn. For a
# single session, await-session in a background Bash call is enough.
#
# Usage: watch-sessions <target>... [--interval S] [--stall N]
# Output: one JSON object per session -> {name, pane, verdict}
#
# A session is reported at `done` (its sentinel), `blocked` (it is holding a
# prompt for the user), `gone` (its pane closed), and — after --stall quiet
# polls — at `pending` (output but no sentinel: it stopped early and needs a
# re-request), `unknown` (a screen holding no evidence at all), or `empty`
# (a fresh or freshly cleared pane). Only a working session keeps the watch
# waiting.
#
# The stalled verdicts wait for --stall consecutive polls because a session
# pausing mid-turn reads exactly like one that stopped early; the other three
# are unambiguous on the first poll and fire at once. A no-evidence verdict
# must be terminal: absence is the steady state of a finished subject, so a
# watch that maps `unlinked` to keep-waiting waits forever. session_verdict
# reads the session's own transcript, so a verdict no longer fades with the
# screen -- what it cannot establish comes back `unlinked`, and that is a
# report of what was observed, not a reason to poll again.
source "$(dirname "$0")/_lib.sh"
require_herdr

targets=() interval=15 stall=3
while [ $# -gt 0 ]; do
  case $1 in
    --interval) interval=${2:?}; shift 2 ;;
    --stall)    stall=${2:?}; shift 2 ;;
    -*)         die "unknown option: $1" ;;
    *)          targets+=("$1"); shift ;;
  esac
done
[ ${#targets[@]} -gt 0 ] || die 'usage: watch-sessions <target>... [--interval S] [--stall N]'

# bash 3.2 has no associative arrays; quiet[i] counts consecutive stalled
# polls for targets[i], and an emptied target marks one already reported.
quiet=()
for i in $(seq 0 $((${#targets[@]} - 1))); do quiet[$i]=0; done

report() {
  jq -nc --arg n "$1" --arg p "$2" --arg v "$3" \
    '{name: $n, pane: $p, verdict: $v}'
}

left=${#targets[@]}
while [ "$left" -gt 0 ]; do
  for i in $(seq 0 $((${#targets[@]} - 1))); do
    t=${targets[$i]}
    [ -n "$t" ] || continue

    row=$(agent_row "$t")
    if [ -z "$row" ]; then
      report "$t" "" gone
      targets[$i]= ; left=$((left - 1))
      continue
    fi

    pane=$(printf '%s' "$row" | jq -r '.pane_id')
    name=$(printf '%s' "$row" | jq -r '.name // ""')
    v=$(session_verdict "$pane" "$name" \
          "$(printf '%s' "$row" | jq -r '.agent_status')")

    case $v in
      done|blocked)
        report "$t" "$pane" "$v"
        targets[$i]= ; left=$((left - 1)) ;;
      unlinked|unknown|empty)
        quiet[$i]=$((${quiet[$i]} + 1))
        if [ "${quiet[$i]}" -ge "$stall" ]; then
          report "$t" "$pane" "$v"
          targets[$i]= ; left=$((left - 1))
        fi ;;
      *)
        quiet[$i]=0 ;;
    esac
  done
  if [ "$left" -gt 0 ]; then sleep "$interval"; fi
done
exit 0
