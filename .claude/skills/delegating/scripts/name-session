#!/usr/bin/env bash
# Compute or parse delegated-session names: <repo-prefix>-<model>-<effort>[-N].
# The name is the only place a session's model and effort are recorded, so a
# session without a convention name cannot be matched — only reported.
#
# Usage: name-session make <repo> <model> <effort>   -> prints a free name
#        name-session parse <name>                   -> prints {repo,model,effort,index}
# Models: fable|opus|sonnet|haiku   Efforts: low|med|high|xhigh
source "$(dirname "$0")/_lib.sh"

MODELS='fable|opus|sonnet|haiku'
EFFORTS='low|med|high|xhigh'

mode=${1:-}; shift || true
case $mode in
  make)
    repo=$(basename "$(repo_path "${1:?make needs <repo>}")")
    model=${2:?make needs <model>}; effort=${3:?make needs <effort>}
    printf '%s' "$model" | grep -Eqx "$MODELS" || die "unknown model: $model"
    printf '%s' "$effort" | grep -Eqx "$EFFORTS" || die "unknown effort: $effort"
    suffix="-$model-$effort"
    # Agent names must match [a-z][a-z0-9_-]{0,31}; keep room for "-NN".
    prefix=$(printf '%s' "$repo" | tr 'A-Z.' 'a-z-' | cut -c1-$((29 - ${#suffix})))
    base="$prefix$suffix"
    taken=$(herdr agent list | jq -r '.result.agents[].name // empty')
    name=$base; n=2
    while printf '%s\n' "$taken" | grep -qx "$name"; do
      name="$base-$n"; n=$((n + 1))
    done
    printf '%s\n' "$name"
    ;;
  parse)
    name=${1:?parse needs <name>}
    if printf '%s' "$name" |
        grep -Eqx "[a-z][a-z0-9_-]*-($MODELS)-($EFFORTS)(-[0-9]+)?"; then
      printf '%s\n' "$name" | sed -E \
        "s/^(.*)-($MODELS)-($EFFORTS)(-([0-9]+))?$/{\"repo\":\"\1\",\"model\":\"\2\",\"effort\":\"\3\",\"index\":\5}/" |
        sed 's/"index":}/"index":1}/'
    else
      printf '{"repo":null,"model":null,"effort":null,"index":null}\n'
    fi
    ;;
  *) die 'usage: name-session make <repo> <model> <effort> | parse <name>' ;;
esac
