#!/usr/bin/python3
"""Retire one session whose output has been collected.

    close-session <name|pane-id> [--force]

The normal end of one delegation (SKILL.md, "Retire one collected worker"),
and now also the way to retire a session nobody named -- one started by hand
or from the phone -- since a pane's own session record, not its agent name,
is what says whether it finished.

The gate is the classifier's: a pane closes when it carries no hold. Every
hold is printed on a refusal, so the reason is never a guess. `--force`
closes regardless and is for an explicit request from the owner, not for
getting past a hold you would rather not read.

Closing discards the pane, so the output is read before this runs, not after.
The evidence behind the report is the session's transcript under
~/.claude/projects/, which answers to the session in /resume.
"""
import argparse
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import session_state as S


def main():
    parser = argparse.ArgumentParser(add_help=True)
    parser.add_argument("target", help="herdr agent name or pane id")
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--quiet-min", type=float, default=S.DEFAULT_QUIET_MIN)
    opts = parser.parse_args()

    herdr = S.Herdr()
    me = os.environ.get("HERDR_PANE_ID")
    if not me:
        sys.exit("refusing to close from outside a herdr pane: "
                 "HERDR_PANE_ID is unset, so nothing excludes the caller.")

    roster = herdr.roster()
    pane = next((p for p in roster
                 if opts.target in (p["pane_id"], p.get("name"))), None)
    if pane is None:
        sys.exit("no session named %r" % opts.target)

    # Naming one pane is an explicit request, so the focus hold -- which
    # keeps a broad sweep off the pane the owner is looking at -- does not
    # apply here.
    row = S.classify(herdr, pane, roster, S.title_index(), opts.quiet_min, me,
                     explicit=True)
    if not S.closable(row) and not opts.force:
        row["closed"] = False
        print(json.dumps(row, ensure_ascii=False))
        sys.exit("held: %s" % ", ".join(row["holds"]))

    herdr.close_pane(row["pane"])
    row["closed"] = not herdr.pane(row["pane"])
    print(json.dumps(row, ensure_ascii=False))


if __name__ == "__main__":
    main()
