#!/usr/bin/python3
"""Check the classifier against transcripts built to order. No herdr, no panes.

Every case is a synthetic session record, so a rule can be broken in the
source and watched to fail here -- which is the only way a guard earns
trust. The screen-fixture suite this replaces is gone with the screen
reading it tested.

    verify-verdicts        run every case, print pass or fail
"""
import json
import os
import sys
import tempfile

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import session_state as S

STAMP = "2026-08-20T%02d:00:00.000Z"


def rows(*items):
    return [dict(item, timestamp=STAMP % (10 + i))
            for i, item in enumerate(items)]


def prompt(text="do the thing"):
    return {"type": "user", "message": {"content": [
        {"type": "text", "text": text}]}}


def says(text, tools=()):
    content = [{"type": "text", "text": text}]
    for index, name in enumerate(tools):
        content.append({"type": "tool_use", "id": "t%d" % index, "name": name})
    return {"type": "assistant", "message": {"content": content}}


def answers(*ids):
    return {"type": "user", "message": {"content": [
        {"type": "tool_result", "tool_use_id": i} for i in ids]}}


def turn_end():
    return {"type": "system", "subtype": "turn_duration"}


CASES = [
    ("a completed turn is done", rows(
        prompt(), says("Landed and pushed."), turn_end()),
     dict(is_empty=False, turn_closed=True, open_tools={}, asks_question=False)),

    ("a pane never prompted is empty", rows(
        {"type": "ai-title", "aiTitle": "Fresh Session"}),
     dict(is_empty=True)),

    ("a hook's own feedback does not count as a prompt", rows(
        {"type": "user", "isMeta": True,
         "message": {"content": [{"type": "text", "text": "stop hook"}]}}),
     dict(is_empty=True)),

    ("an unanswered tool call holds the pane", rows(
        prompt(), says("Asking.", tools=["AskUserQuestion"])),
     dict(turn_closed=False, open_tools={"t0": "AskUserQuestion"})),

    ("an answered tool call does not", rows(
        prompt(), says("Reading.", tools=["Read"]), answers("t0"),
        says("Done."), turn_end()),
     dict(turn_closed=True, open_tools={})),

    ("a turn reopened after its end is not closed", rows(
        prompt(), says("Done."), turn_end(), prompt("one more thing")),
     dict(turn_closed=False)),

    ("a turn ending in a question holds the pane", rows(
        prompt(), says("Which one did you mean?"), turn_end()),
     dict(turn_closed=True, asks_question=True)),

    ("a full-width question mark counts too", rows(
        prompt(), says("어느 쪽인가요？"), turn_end()),
     dict(asks_question=True)),

    ("a question in an earlier turn does not", rows(
        prompt(), says("Which one?"), turn_end(),
        prompt("the first"), says("Done."), turn_end()),
     dict(asks_question=False)),

    ("every working directory is collected", rows(
        dict(prompt(), cwd="/a"), dict(says("ok"), cwd="/b"), turn_end()),
     dict(cwds={"/a", "/b"})),
]


def check_state():
    failures = []
    for label, record, expected in CASES:
        state = S.TranscriptState(record)
        for field, want in expected.items():
            got = getattr(state, field)
            if got != want:
                failures.append("%s: %s is %r, expected %r"
                                % (label, field, got, want))
    return failures


def check_gate():
    """The git gate holds a dirty repository and releases a clean one."""
    failures = []
    with tempfile.TemporaryDirectory() as tmp:
        os.system("git -C %s init -q 2>/dev/null" % tmp)
        S._REPO_CACHE.clear()
        if S.unclean_repos([tmp]):
            failures.append("git gate: an empty repository read unclean")
        open(os.path.join(tmp, "work.txt"), "w").write("uncommitted\n")
        S._REPO_CACHE.clear()
        if not S.unclean_repos([tmp]):
            failures.append("git gate: an uncommitted file read clean")
    S._REPO_CACHE.clear()
    return failures


def check_titles():
    """A session is findable by whichever title it wears last."""
    failures = []
    original = S.PROJECTS
    with tempfile.TemporaryDirectory() as tmp:
        project = os.path.join(tmp, "-a-project")
        os.makedirs(project)

        def write(name, *rows):
            with open(os.path.join(project, name + ".jsonl"), "w") as fh:
                for row in rows:
                    fh.write(json.dumps(row) + "\n")

        write("aaa", {"type": "ai-title", "aiTitle": "Generated Name"})
        write("bbb", {"type": "ai-title", "aiTitle": "Old Name"},
                     {"type": "custom-title", "customTitle": "renamed-by-hand"})
        write("ccc", {"type": "ai-title", "aiTitle": "Shared Name"})
        write("ddd", {"type": "ai-title", "aiTitle": "Shared Name"})

        S.PROJECTS = tmp
        index = S.title_index()
        S.PROJECTS = original

    if index.get("Generated Name") != ["aaa"]:
        failures.append("titles: a generated title did not resolve")
    if index.get("renamed-by-hand") != ["bbb"]:
        failures.append("titles: a hand-typed title did not resolve")
    if "Old Name" in index:
        failures.append("titles: a superseded title still resolved")
    if sorted(index.get("Shared Name") or []) != ["ccc", "ddd"]:
        failures.append("titles: a shared title lost a candidate")
    return failures


def check_closable():
    """Only an empty hold list closes, whatever the verdict says."""
    failures = []
    if not S.closable({"verdict": "done", "holds": []}):
        failures.append("closable: a done pane with no hold did not close")
    if S.closable({"verdict": "done", "holds": ["self"]}):
        failures.append("closable: a hold did not stop a done pane")
    if S.closable({"verdict": "unlinked", "holds": []}):
        failures.append("closable: an unlinked pane was closable")
    return failures


def main():
    failures = check_state() + check_gate() + check_titles() + check_closable()
    total = len(CASES) + 9
    for line in failures:
        print("FAIL  %s" % line)
    print("%d/%d checks passed" % (total - len(failures), total))
    sys.exit(1 if failures else 0)


if __name__ == "__main__":
    main()
