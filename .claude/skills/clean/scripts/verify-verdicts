#!/usr/bin/python3
"""Check the classifier against transcripts built to order. No herdr, no panes.

The board half is checked here too, against ticket records built the same
way: which rows a sweep is responsible for is a decision, so it is pinned
like every other one.

Every case is a synthetic session record, so a rule can be broken in the
source and watched to fail here -- which is the only way a guard earns
trust. The screen-fixture suite this replaces is gone with the screen
reading it tested.

    verify-verdicts        run every case, print pass or fail
"""
import json
import os
import sys
import tempfile

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import board_tickets as B
import session_state as S

STAMP = "2026-08-20T%02d:00:00.000Z"


def rows(*items):
    return [dict(item, timestamp=STAMP % (10 + i))
            for i, item in enumerate(items)]


def prompt(text="do the thing"):
    return {"type": "user", "message": {"content": [
        {"type": "text", "text": text}]}}


def says(text, tools=()):
    content = [{"type": "text", "text": text}]
    for index, name in enumerate(tools):
        content.append({"type": "tool_use", "id": "t%d" % index, "name": name})
    return {"type": "assistant", "message": {"content": content}}


def answers(*ids):
    return {"type": "user", "message": {"content": [
        {"type": "tool_result", "tool_use_id": i} for i in ids]}}


def turn_end():
    return {"type": "system", "subtype": "turn_duration"}


CASES = [
    ("a completed turn is done", rows(
        prompt(), says("Landed and pushed."), turn_end()),
     dict(is_empty=False, turn_closed=True, open_tools={}, asks_question=False)),

    ("a pane never prompted is empty", rows(
        {"type": "ai-title", "aiTitle": "Fresh Session"}),
     dict(is_empty=True)),

    ("a hook's own feedback does not count as a prompt", rows(
        {"type": "user", "isMeta": True,
         "message": {"content": [{"type": "text", "text": "stop hook"}]}}),
     dict(is_empty=True)),

    ("an unanswered tool call holds the pane", rows(
        prompt(), says("Asking.", tools=["AskUserQuestion"])),
     dict(turn_closed=False, open_tools={"t0": "AskUserQuestion"})),

    ("an answered tool call does not", rows(
        prompt(), says("Reading.", tools=["Read"]), answers("t0"),
        says("Done."), turn_end()),
     dict(turn_closed=True, open_tools={})),

    ("a turn reopened after its end is not closed", rows(
        prompt(), says("Done."), turn_end(), prompt("one more thing")),
     dict(turn_closed=False)),

    ("a turn ending in a question holds the pane", rows(
        prompt(), says("Which one did you mean?"), turn_end()),
     dict(turn_closed=True, asks_question=True)),

    ("a full-width question mark counts too", rows(
        prompt(), says("어느 쪽인가요？"), turn_end()),
     dict(asks_question=True)),

    ("a question in an earlier turn does not", rows(
        prompt(), says("Which one?"), turn_end(),
        prompt("the first"), says("Done."), turn_end()),
     dict(asks_question=False)),

    ("every working directory is collected", rows(
        dict(prompt(), cwd="/a"), dict(says("ok"), cwd="/b"), turn_end()),
     dict(cwds={"/a", "/b"})),
]


def check_state():
    failures = []
    for label, record, expected in CASES:
        state = S.TranscriptState(record)
        for field, want in expected.items():
            got = getattr(state, field)
            if got != want:
                failures.append("%s: %s is %r, expected %r"
                                % (label, field, got, want))
    return failures


def check_gate():
    """The git gate holds a dirty repository and releases a clean one."""
    failures = []
    with tempfile.TemporaryDirectory() as tmp:
        os.system("git -C %s init -q 2>/dev/null" % tmp)
        S._REPO_CACHE.clear()
        if S.unclean_repos([tmp]):
            failures.append("git gate: an empty repository read unclean")
        open(os.path.join(tmp, "work.txt"), "w").write("uncommitted\n")
        S._REPO_CACHE.clear()
        if not S.unclean_repos([tmp]):
            failures.append("git gate: an uncommitted file read clean")
    S._REPO_CACHE.clear()
    return failures


def check_titles():
    """A session is findable by whichever title it wears last."""
    failures = []
    original = S.PROJECTS
    with tempfile.TemporaryDirectory() as tmp:
        project = os.path.join(tmp, "-a-project")
        os.makedirs(project)

        def write(name, *rows):
            with open(os.path.join(project, name + ".jsonl"), "w") as fh:
                for row in rows:
                    fh.write(json.dumps(row) + "\n")

        write("aaa", {"type": "ai-title", "aiTitle": "Generated Name"})
        write("bbb", {"type": "ai-title", "aiTitle": "Old Name"},
                     {"type": "custom-title", "customTitle": "renamed-by-hand"})
        write("ccc", {"type": "ai-title", "aiTitle": "Shared Name"})
        write("ddd", {"type": "ai-title", "aiTitle": "Shared Name"})

        S.PROJECTS = tmp
        index = S.title_index()
        S.PROJECTS = original

    if index.get("Generated Name") != ["aaa"]:
        failures.append("titles: a generated title did not resolve")
    if index.get("renamed-by-hand") != ["bbb"]:
        failures.append("titles: a hand-typed title did not resolve")
    if "Old Name" in index:
        failures.append("titles: a superseded title still resolved")
    if sorted(index.get("Shared Name") or []) != ["ccc", "ddd"]:
        failures.append("titles: a shared title lost a candidate")
    return failures


def check_closable():
    """Only an empty hold list closes, whatever the verdict says."""
    failures = []
    if not S.closable({"verdict": "done", "holds": []}):
        failures.append("closable: a done pane with no hold did not close")
    if S.closable({"verdict": "done", "holds": ["self"]}):
        failures.append("closable: a hold did not stop a done pane")
    if S.closable({"verdict": "unlinked", "holds": []}):
        failures.append("closable: an unlinked pane was closable")
    return failures


#: What one waiting caller must be told, per (verdict, holds) the sweep
#: produced. The pairs a sweep and a wait read differently are the point of
#: the table: `done` plus a live hold is a session still running.
WAIT_CASES = [
    ("a finished turn reads done",
     dict(verdict="done", holds=[]), "done"),
    ("a running session does not read done",
     dict(verdict="done", holds=["status:working", "mid-turn"]), "working"),
    ("a session mid-turn between polls is still working",
     dict(verdict="done", holds=["mid-turn"]), "working"),
    ("an unanswered tool call is working",
     dict(verdict="done", holds=["awaiting:Read"]), "working"),
    ("a pane holding a prompt is blocked",
     dict(verdict="done", holds=["status:blocked", "awaiting:Bash"]),
     "blocked"),
    ("a turn ending in a question is blocked",
     dict(verdict="done", holds=["asks-question"]), "blocked"),
    ("a parent owing a worker its report is working",
     dict(verdict="done", holds=["worker:build-x--sub-y"]), "working"),
    ("a fresh pane running its first turn is not empty",
     dict(verdict="empty", holds=["status:working"]), "working"),
    ("an uncommitted repository does not hold the wait",
     dict(verdict="done", holds=["unclean:board", "fresh:2m"]), "done"),
    ("the sweeping pane itself does not hold the wait",
     dict(verdict="done", holds=["self"]), "done"),
    ("no evidence stays no evidence",
     dict(verdict="unlinked", holds=["unlinked"]), "unlinked"),
    ("an unknown status is terminal, not another poll",
     dict(verdict="done", holds=["status:unknown"]), "unknown"),
]


def check_wait():
    """A caller reads one word, so the word has to carry the holds."""
    failures = []
    for label, row, want in WAIT_CASES:
        got = S.verdict_of(row)
        if got != want:
            failures.append("%s: verdict_of is %r, expected %r"
                            % (label, got, want))
    return failures


def ticket(state="working", sessions=(), tags=("code",)):
    return {"id": "p:1", "title": "a row", "state": state,
            "tags": list(tags),
            "sessions": [{"id": s, "name": "n-" + s} for s in sessions]}


def check_clock():
    """The elapsed minutes need an anchor a later reader can still trust."""
    failures = []
    if S.local_clock(None) is not None:
        failures.append("clock: a session with no timestamp got a reading")
    stamp = S.parse_ts(STAMP % 13)
    want = stamp.astimezone().strftime("%H:%M")
    if S.local_clock(stamp) != want:
        failures.append("clock: %r is not the local reading %r"
                        % (S.local_clock(stamp), want))
    return failures


def check_tickets():
    """A row is the sweep's only when its own session is gone."""
    failures = []

    def want(label, row, live, action):
        got = (B.action(row, live) or {}).get("action")
        if got != action:
            failures.append("%s: action is %r, expected %r"
                            % (label, got, action))

    want("a row nobody holds is released", ticket(), set(), "release")
    want("a row its own session still holds is left alone",
         ticket(sessions=["s1"]), {"s1"}, None)
    want("another session's pane does not hold this row",
         ticket(sessions=["s1"]), {"s2"}, "release")
    want("a holder board knows by name alone is still a holder",
         ticket(sessions=["s1"]), {"n-s1"}, None)
    want("an open row is not the sweep's business",
         ticket(state="open"), set(), None)
    want("a #need-you row is held, never released",
         ticket(tags=["code", "need-you"]), set(), "held")
    return failures


def main():
    failures = (check_state() + check_gate() + check_titles()
                + check_closable() + check_wait() + check_tickets()
                + check_clock())
    total = len(CASES) + len(WAIT_CASES) + 9 + 6 + 2
    for line in failures:
        print("FAIL  %s" % line)
    print("%d/%d checks passed" % (total - len(failures), total))
    sys.exit(1 if failures else 0)


if __name__ == "__main__":
    main()
