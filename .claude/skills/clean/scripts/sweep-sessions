#!/usr/bin/python3
"""Report every session pane under ~/workspace, and optionally retire it.

The board rows behind those panes are swept in the same pass: a row still
marked `working` whose session is gone is released back to `open`, so the
board stops waiting on a session that no longer exists.

    sweep-sessions [<repo>] [--close] [--quiet-min N]

One JSON object per pane: {repo, pane, name, title, status, session, link,
quiet_min, last_active, verdict, holds, closable}, where `quiet_min` is the
minutes since the session's last record and `last_active` is the wall-clock
reading it was taken against -- quote that one when the list is read later
than it was taken -- plus `closed` under --close. Then one
per board row needing attention: {ticket, title, action, reason}, where the
action is `release` (nobody holds it), `held` (tagged #need-you, the owner's
to end) or `unreachable` (the board did not answer). A released row is not a
finished one: closing it says the work shipped, which only a reader of the
session's report can say.

`holds` is the safety argument in the open: a pane retires only when that
list is empty, so every reason one survives is printed beside it. Read the
holds before asking why something stayed.

Verdicts:
  done      the session's own record shows its last turn complete
  empty     a session pane that was never prompted
  unlinked  no transcript could be tied to the pane -- never closable
  shell     a pane with no agent, its shell idle
  shell-busy  a pane with no agent, a command running
  <status>  herdr's own state when it is not idle: working, blocked, unknown

Panes at the container root are swept like any other repository's, and so is
the pane the owner is looking at. Only the sweeping session's own `self` hold
keeps it alive, so an orchestrator that finished its work retires with the
workers it drove.
"""
import argparse
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import board_tickets as B
import session_state as S


def main():
    parser = argparse.ArgumentParser(add_help=True)
    parser.add_argument("repo", nargs="?")
    parser.add_argument("--close", action="store_true")
    parser.add_argument("--quiet-min", type=float, default=S.DEFAULT_QUIET_MIN)
    parser.add_argument("--pane", action="append", default=[])
    opts = parser.parse_args()

    args = argparse.Namespace(
        repo=opts.repo,
        pane=opts.pane,
        quiet_min=opts.quiet_min,
    )
    herdr = S.Herdr()
    me = os.environ.get("HERDR_PANE_ID")

    if opts.close:
        if not me:
            sys.exit("refusing to close from outside a herdr pane: "
                     "HERDR_PANE_ID is unset, so nothing excludes the caller.")
        rows = S.do_close(herdr, args, me)
    else:
        rows = S.gather(herdr, args, me)
        for row in rows:
            row["closable"] = S.closable(row)

    for row in rows:
        print(json.dumps(row, ensure_ascii=False))

    # A pane the sweep just closed is not live, whatever the roster still says.
    live = {row["session"] for row in rows
            if row["session"] and not row.get("closed")}
    for row in B.sweep(live, opts.close, "sweep-sessions",
                       os.environ.get("CLAUDE_CODE_SESSION_ID"),
                       os.environ.get("CLAUDE_SESSION_NAME")):
        print(json.dumps(row, ensure_ascii=False))


if __name__ == "__main__":
    main()
